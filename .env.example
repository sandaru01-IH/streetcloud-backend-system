# Copy to .env at the repository root or services/api/.env. Placeholders only.

ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./data/streetcloud.db
# Full local stack:
# DATABASE_URL=postgresql+asyncpg://streetcloud:streetcloud@localhost:5432/streetcloud
REDIS_URL=
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/objects
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=streetcloud-private
STORAGE_ACCESS_KEY=streetcloud
STORAGE_SECRET_KEY=streetcloud-secret
STORAGE_REGION=us-east-1
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
PUBLIC_BASE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_VISION_MODEL=
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_API=auto
HOSTED_GPU_ENDPOINT=
HOSTED_GPU_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=
COMFY_URL=
MAX_UPLOAD_MB=20
EMBED_WORKER=true
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
RETENTION_DAYS=90

# Mobile (public URL only — never put provider keys here)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
